{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [ "SshSharp/SshSharp.csproj", "SshSharp.FileProviders/SshSharp.FileProviders.csproj", "SshSharp.IO.Abstractions/SshSharp.IO.Abstractions.csproj" ]
        }
      ],
      "output": "api",
      "properties": { "TargetFramework": "net10.0" },
      "memberLayout": "separatePages",
      "namespaceLayout": "flattened"
    }
  ],
  "build": {
    "content": [
      { "files": [ "api/**.yml", "api/index.md" ] },
      { "files": [ "*.md", "toc.yml" ], "exclude": [ "README.md" ] }
    ],
    "resource": [
      { "files": [ "images/**" ] }
    ],
    "output": "_site",
    "sitemap": { "baseUrl": "https://zcsizmadia.github.io/SshSharp/" },
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "SshSharp",
      "_appTitle": "SshSharp",
      "_appFooter": "SshSharp: managed SSH for .NET. MIT license.",
      "_appLogoPath": "images/sshsharp.svg",
      "_appFaviconPath": "images/sshsharp.svg",
      "_enableSearch": true
    },
    "warningsAsErrors": true
  }
}
