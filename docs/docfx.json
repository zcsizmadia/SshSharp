{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [ "SshSharp/SshSharp.csproj", "SshSharp.FileProviders/SshSharp.FileProviders.csproj", "SshSharp.IO.Abstractions/SshSharp.IO.Abstractions.csproj", "SshSharp.Extensions.DependencyInjection/SshSharp.Extensions.DependencyInjection.csproj" ]
        }
      ],
      "output": "api",
      "properties": { "TargetFramework": "net10.0" },
      "memberLayout": "separatePages",
      "namespaceLayout": "flattened"
    }
  ],
  "build": {
    "content": [
      { "files": [ "api/**.yml", "api/index.md" ] },
      { "files": [ "**/*.md", "**/toc.yml" ], "exclude": [ "README.md", "_site/**", "api/**", "snippets/**" ] }
    ],
    "resource": [
      { "files": [ "images/**" ] }
    ],
    "output": "_site",
    "sitemap": { "baseUrl": "https://zcsizmadia.github.io/SshSharp/" },
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "SshSharp",
      "_appTitle": "SshSharp",
      "_appFooter": "SshSharp: a managed, async-first SSH client for .NET. MIT license. <a href=\"https://github.com/zcsizmadia/SshSharp\">Source on GitHub</a>.",
      "_appLogoPath": "images/sshsharp.svg",
      "_appFaviconPath": "images/sshsharp.svg",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": { "repo": "https://github.com/zcsizmadia/SshSharp", "branch": "main" }
    },
    "warningsAsErrors": true
  }
}
