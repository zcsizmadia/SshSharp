<Project Sdk="Microsoft.NET.Sdk">
  <!-- Published with Native AOT in CI and run against a real server: proves the library works trimmed and AOT-compiled, not only
       that its analyzers are satisfied. Trim and AOT warnings fail the publish (warnings are errors), one per member. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SshSharp/SshSharp.csproj" />
  </ItemGroup>
</Project>
