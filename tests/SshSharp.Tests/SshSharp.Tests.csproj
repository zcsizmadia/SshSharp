<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The SFTP API is marked [Experimental] for its callers; the library and its tests use it on purpose. -->
    <NoWarn>$(NoWarn);SSHSHARP001</NoWarn>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>
  <!-- As in the library: the stress workflow's instrumented build (src/SshSharp/Protocol/Instrumentation.cs). -->
  <PropertyGroup Condition="'$(SshSharpInstrument)' == 'true'">
    <DefineConstants>$(DefineConstants);SSHSHARP_INSTRUMENT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="../../src/SshSharp/SshSharp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SshSharp.FileProviders\SshSharp.FileProviders.csproj" />
    <ProjectReference Include="..\..\src\SshSharp.IO.Abstractions\SshSharp.IO.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\SshSharp.Extensions.DependencyInjection\SshSharp.Extensions.DependencyInjection.csproj" />
  </ItemGroup>
</Project>