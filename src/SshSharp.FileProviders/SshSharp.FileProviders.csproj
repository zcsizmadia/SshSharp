<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>SshSharp.FileProviders</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>SshSharp.FileProviders</PackageId>
    <Description>An IFileProvider over SFTP (SshSharp): serve files from an SSH server to ASP.NET Core static files, Razor, configuration and anything else that reads through Microsoft.Extensions.FileProviders.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://zcsizmadia.github.io/SshSharp/</PackageProjectUrl>
    <PackageTags>ssh;sftp;fileprovider;ifileprovider;aspnetcore;staticfiles;virtual-file-system</PackageTags>
    <PackageReleaseNotes>https://github.com/zcsizmadia/SshSharp/releases</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/zcsizmadia/SshSharp</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- The public API is tracked in PublicAPI.*.txt, and packing validates it against the previous release on nuget.org. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.1.0</PackageValidationBaselineVersion>

    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />
    <PackageReference Include="MinVer" PrivateAssets="All" />
    <!-- The oldest version each target supports, so an app on .NET 8 keeps its framework's 8.x packages. -->
    <PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions" VersionOverride="8.0.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions" Condition="'$(TargetFramework)' != 'net8.0'" />
    <ProjectReference Include="../SshSharp/SshSharp.csproj" />
    <!-- The session handling both adapters share (the caller's session, or a factory's, opened again after a failure). -->
    <Compile Include="../Shared/SftpSessions.cs" Link="Shared/SftpSessions.cs" />
    <!-- The tests run the timeouts on a fake clock (SftpFileProviderOptions.Clock). -->
    <InternalsVisibleTo Include="SshSharp.Tests" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/logo/sshsharp-128.png" Pack="true" PackagePath="/icon.png" Visible="false" />
  </ItemGroup>
</Project>
