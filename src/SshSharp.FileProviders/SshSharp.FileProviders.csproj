<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Built on the experimental SFTP API, and experimental itself. -->
    <NoWarn>$(NoWarn);SSHSHARP001</NoWarn>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>SshSharp.FileProviders</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>SshSharp.FileProviders</PackageId>
    <Description>An IFileProvider over SFTP (SshSharp): serve files from an SSH server to ASP.NET Core static files, Razor, configuration and anything else that reads through Microsoft.Extensions.FileProviders.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://zcsizmadia.github.io/SshSharp/</PackageProjectUrl>
    <PackageTags>ssh;sftp;fileprovider;ifileprovider;aspnetcore;staticfiles;virtual-file-system</PackageTags>
    <PackageReleaseNotes>https://github.com/zcsizmadia/SshSharp/releases</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/zcsizmadia/SshSharp</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- The public API is tracked in PublicAPI.*.txt; a baseline version is added after the first release. -->
    <EnablePackageValidation>true</EnablePackageValidation>

    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />
    <PackageReference Include="MinVer" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions" />
    <ProjectReference Include="../SshSharp/SshSharp.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
