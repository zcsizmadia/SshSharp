<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>SshSharp</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>SshSharp</PackageId>
    <Description>Managed-only, async-first SSH client library for .NET with known_hosts and ssh_config support.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/zcsizmadia/SshSharp</PackageProjectUrl>
    <PackageTags>ssh;ssh-client;openssh;scp;port-forwarding;known_hosts;ssh_config;ssh-agent;proxyjump;async</PackageTags>
    <PackageReleaseNotes>https://github.com/zcsizmadia/SshSharp/releases</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/zcsizmadia/SshSharp</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- The public API is tracked in PublicAPI.*.txt (RS0016/RS0017), and packing validates it against earlier versions. -->
    <EnablePackageValidation>true</EnablePackageValidation>

    <!-- The version comes from git tags (v0.1.0, v1.0.0-preview.1, ...): MinVer gives untagged commits a 0.x prerelease version. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />
    <PackageReference Include="MinVer" PrivateAssets="All" />
    <PackageReference Include="System.IO.Pipelines" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>