<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The SFTP API is marked [Experimental] for its callers; the library and its tests use it on purpose. -->
    <NoWarn>$(NoWarn);SSHSHARP001</NoWarn>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>SshSharp</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>SshSharp</PackageId>
    <Description>Managed-only, async-first SSH client library for .NET with known_hosts and ssh_config support.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://zcsizmadia.github.io/SshSharp/</PackageProjectUrl>
    <PackageTags>ssh;ssh-client;openssh;scp;port-forwarding;known_hosts;ssh_config;ssh-agent;proxyjump;async</PackageTags>
    <PackageReleaseNotes>https://github.com/zcsizmadia/SshSharp/releases</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/zcsizmadia/SshSharp</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- The public API is tracked in PublicAPI.*.txt (RS0016/RS0017), and packing validates it against earlier versions. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Each release is checked against the previous one on nuget.org: an unintended breaking change fails the pack. -->
    <PackageValidationBaselineVersion>0.5.0</PackageValidationBaselineVersion>

    <!-- The version comes from git tags (v0.1.0, v1.0.0-preview.1, ...): MinVer gives untagged commits a 0.x prerelease version. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
  </PropertyGroup>
  <!-- Troubleshooting checks (Protocol/Instrumentation.cs), for the stress workflow only: dotnet build -p:SshSharpInstrument=true. -->
  <PropertyGroup Condition="'$(SshSharpInstrument)' == 'true'">
    <DefineConstants>$(DefineConstants);SSHSHARP_INSTRUMENT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />
    <PackageReference Include="MinVer" PrivateAssets="All" />
    <!-- The oldest version each target supports, so an app on .NET 8 keeps its framework's 8.x packages. -->
    <PackageReference Include="System.IO.Pipelines" VersionOverride="8.0.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="System.IO.Pipelines" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="8.0.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Condition="'$(TargetFramework)' != 'net8.0'" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/logo/sshsharp-128.png" Pack="true" PackagePath="/icon.png" Visible="false" />
  </ItemGroup>
</Project>