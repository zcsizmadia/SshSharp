<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>SshSharp.IO.Abstractions</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>SshSharp.IO.Abstractions</PackageId>
    <Description>An IFileSystem (System.IO.Abstractions) over SFTP (SshSharp): code written against IFileSystem reads and writes a directory on an SSH server, with nothing mounted.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://zcsizmadia.github.io/SshSharp/</PackageProjectUrl>
    <PackageTags>ssh;sftp;system.io.abstractions;ifilesystem;testableio;virtual-file-system</PackageTags>
    <PackageReleaseNotes>https://github.com/zcsizmadia/SshSharp/releases</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/zcsizmadia/SshSharp</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- The public API is tracked in PublicAPI.*.txt, and packing validates it against the previous release on nuget.org. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.1.0</PackageValidationBaselineVersion>

    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />
    <PackageReference Include="MinVer" PrivateAssets="All" />
    <PackageReference Include="TestableIO.System.IO.Abstractions" />
    <ProjectReference Include="../SshSharp/SshSharp.csproj" />
    <!-- The session handling both adapters share (the caller's session, or a factory's, opened again after a failure). -->
    <Compile Include="../Shared/SftpSessions.cs" Link="Shared/SftpSessions.cs" />
    <!-- The tests run the timeouts on a fake clock (SftpFileSystemOptions.Clock). -->
    <InternalsVisibleTo Include="SshSharp.Tests" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/logo/sshsharp-128.png" Pack="true" PackagePath="/icon.png" Visible="false" />
  </ItemGroup>
</Project>
