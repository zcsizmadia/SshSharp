{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Ssh": {
    "Server": {
      "Host": "server.example.com",
      "UserName": "app",
      "PrivateKeyFiles": [ "~/.ssh/id_ed25519" ],
      "KeepAliveInterval": "00:00:15",
      "ReconnectDelay": "00:00:02",
      "MaxReconnectDelay": "00:01:00"
    }
  },
  "Tail": {
    "File": "/var/log/syslog"
  }
}
