<Project Sdk="Microsoft.NET.Sdk">
  <!-- An ssh-like command-line tool that shows the common tasks. Built with the solution, so it keeps compiling as the API changes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SshSharp/SshSharp.csproj" />
    <ProjectReference Include="../../src/SshSharp.IO.Abstractions/SshSharp.IO.Abstractions.csproj" />
  </ItemGroup>
</Project>
