{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SshSharp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Ssh": {
    "Server": {
      "Host": "server.example.com",
      "UserName": "app",
      "PrivateKeyFiles": [ "~/.ssh/id_ed25519" ],
      "KeepAliveInterval": "00:00:30"
    },
    "FilesRoot": "files",
    "StaticRoot": ""
  }
}
