<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!--
      The target frameworks, in one place: a new .NET version is added here, not in each project.
      SshSharpTargetFrameworks: the packages, the tests, the benchmarks and the AOT smoke test (every supported runtime).
      SshSharpAppTargetFramework: the samples, the doc snippets and the fuzzer (one runtime is enough; the LTS one users run).
    -->
    <SshSharpTargetFrameworks>net8.0;net10.0;net11.0</SshSharpTargetFrameworks>
    <SshSharpAppTargetFramework>net10.0</SshSharpAppTargetFramework>

    <!-- Package metadata shared by the published packages (only the src projects are packable). -->
    <Authors>zcsizmadia</Authors>

    <!-- Supply chain: fail the build on known-vulnerable packages, direct or transitive (warnings are errors). -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>
</Project>